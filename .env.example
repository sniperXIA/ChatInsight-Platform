# ==============================================================================
# ChatInsight Platform Configuration Template (.env.example)
# ==============================================================================

# ----------------- 1. Database & Storage -----------------
# SQLite Async with WAL mode (Default for local development & single-node server)
CI_DATABASE_URL=sqlite+aiosqlite:///chatinsight.db
# PostgreSQL (Optional for large-scale multi-worker production deployment)
# CI_DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/chatinsight

# ----------------- 2. WeChat Raw Archives Path -----------------
# macOS/Linux local path or sample data
CHAT_ARCHIVE_PATH=./sample_data
# Ubuntu production path:
# CHAT_ARCHIVE_PATH=/data/wechat_exports
# Windows path:
# CHAT_ARCHIVE_PATH=D:/玩家群聊天信息2

# ----------------- 3. Web Service & Security -----------------
CI_PORT=8000
CI_PUBLIC_BASE_URL=http://localhost:8000
CI_SECRET_MASTER_KEY=change-this-master-secret-key-32bytes-min

# ----------------- 4. AI & Model Gateway (OpenRouter / Local LLM) -----------------
CI_MODEL_PROVIDER=openrouter
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-api-key-here

# Default Models
DEFAULT_VISION_MODEL=qwen/qwen-2.5-vl-72b-instruct
DEFAULT_TEXT_MODEL=deepseek/deepseek-chat
INSIGHT_MODEL=deepseek/deepseek-chat
JUDGE_MODEL=deepseek/deepseek-chat
ASSISTANT_MODEL=deepseek/deepseek-chat

# ----------------- 5. Media Pipeline (FFmpeg) -----------------
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
MEDIA_DERIVED_CACHE_DIR=./data/cache/previews

# ----------------- 6. ABC User Feedback / Feishu Bitable Integration -----------------
# ABC_FEEDBACK_API_URL=http://localhost:8080
# ABC_FEEDBACK_API_KEY=your_abc_token
